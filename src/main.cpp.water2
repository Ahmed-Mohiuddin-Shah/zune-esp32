#include <zyngine.h>
#include <stdint.h>
#include <cmath>
#include <algorithm>

const int WATER_WIDTH = 64;
const int WATER_HEIGHT = 64;
const float WATER_DAMPING = 0.996f;
const float WATER_SPREAD = 0.2f;
const float BASE_HEIGHT = 0.0f;
const float FORCE = 1.0f;

struct WaterSimulation
{
    float heights[WATER_HEIGHT * WATER_WIDTH];
    float velocities[WATER_HEIGHT * WATER_WIDTH];
    ZynTexture water;
    float waveTime;

    inline int idx(int x, int y) const { return y * WATER_WIDTH + x; }

    void Init()
    {
        for (int i = 0; i < WATER_WIDTH * WATER_HEIGHT; ++i)
        {
            heights[i] = BASE_HEIGHT;
            velocities[i] = 0.0f;
        }
        waveTime = 0.0f;
    }

    void Update()
    {
        // Update velocities
        for (int y = 1; y < WATER_HEIGHT - 1; y++)
        {
            for (int x = 1; x < WATER_WIDTH - 1; x++)
            {
                int i = idx(x, y);
                float heightDiff = (heights[idx(x, y - 1)] + heights[idx(x, y + 1)] +
                                    heights[idx(x - 1, y)] + heights[idx(x + 1, y)] -
                                    4 * heights[i]);
                velocities[i] += heightDiff * WATER_SPREAD;
                velocities[i] *= WATER_DAMPING;
            }
        }

        // Update heights
        for (int i = 0; i < WATER_WIDTH * WATER_HEIGHT; ++i)
            heights[i] += velocities[i];

        // Update texture
        for (int y = 0; y < WATER_HEIGHT; y++)
        {
            for (int x = 0; x < WATER_WIDTH; x++)
            {
                int i = idx(x, y);
                float normalizedHeight = (heights[i] - BASE_HEIGHT) * 32.0f + 128.0f;
                normalizedHeight = std::max(0.0f, std::min(normalizedHeight, 255.0f));
                uint8_t r = static_cast<uint8_t>(normalizedHeight * 0.2f);
                uint8_t g = static_cast<uint8_t>(normalizedHeight * 0.3f);
                uint8_t b = static_cast<uint8_t>(normalizedHeight);
                uint16_t color = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
                water.setPixel(x, y, color);
            }
        }
    }

    void AddSplash(int x, int y, float force)
    {
        if (x >= 0 && x < WATER_WIDTH && y >= 0 && y < WATER_HEIGHT)
        {
            velocities[idx(x, y)] += force;
            for (int dy = -2; dy <= 2; dy++)
            {
                for (int dx = -2; dx <= 2; dx++)
                {
                    int nx = x + dx;
                    int ny = y + dy;
                    if (nx >= 0 && nx < WATER_WIDTH && ny >= 0 && ny < WATER_HEIGHT)
                    {
                        float dist = sqrtf(dx * dx + dy * dy);
                        if (dist < 3.0f)
                        {
                            velocities[idx(nx, ny)] += force * (1.0f - dist / 3.0f);
                        }
                    }
                }
            }
        }
    }

    void Draw(ZynRenderer *renderer)
    {
        // Only draw the texture once per frame
        renderer->drawTextureToBox(&water, 0, 0, 320, 480);
    }
};

class WaterSim : public Zyngine
{

private:
    WaterSimulation water;

    void onUserCreate() override
    {
        water.Init();
    }

    void onUserUpdate(float deltaTime) override
    {
        water.Update();
#ifdef ZYNGINE_NATIVE_RAYLIB
        if (IsMouseButtonDown(MOUSE_BUTTON_LEFT))
        {
            int splashX = static_cast<int>(GetMousePosition().x * WATER_WIDTH / (float)screenWidth);
            int splashY = static_cast<int>((screenHeight - GetMousePosition().y) * WATER_HEIGHT / (float)screenHeight);
            water.AddSplash(splashX, splashY, FORCE);
        }
        if (IsKeyPressed(KEY_R))
        {
            water.Init();
        }
#endif
#ifdef ZYNGINE_ESP32S3
        if (!digitalRead(ENCODER_BUTTON))
        {
            int splashX = static_cast<int>(gui.cursorPos.x * WATER_WIDTH / 320.0f);
            int splashY = static_cast<int>(gui.cursorPos.y * WATER_HEIGHT / 480.0f);
            water.AddSplash(splashX, splashY, FORCE);
        }
        if (!digitalRead(HOME_BUTTON))
        {
            water.Init();
        }
#endif
        renderer->drawTextureToBox(&water.water, 0, 0, 320, 480);
    }
};

WaterSim engine;

void setup()
{
    engine.initialize(320, 480, 60);
}

void loop()
{
    engine.run();
}

#ifdef ZYNGINE_NATIVE_RAYLIB
int main()
{
    setup();
    loop();
}
#endif