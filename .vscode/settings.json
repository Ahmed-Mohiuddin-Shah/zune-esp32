{
  // clangd owns C++ hover / goto / errors in Cursor. Disable Microsoft IntelliSense
  // so the two engines don't fight (common cause of "no hover / no Ctrl+click").
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "clangd.path": "/home/mohiuddin/.local/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy=0",
    "--header-insertion=never"
  ],
  // compile DBs: root .clangd → build/; ESP platform → examples/espidf_smoke/build
  "cmake.configureOnOpen": true,
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "files.associations": {
    "*.h": "c",
    "*.hpp": "cpp",
    "*.cpp": "cpp"
  },
  "cSpell.words": [
    "Clay",
    "espidf",
    "FocusNav",
    "Lovyan",
    "raylib",
    "zyngine",
    "ZynColor"
  ]
}
