{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure desktop (Debug)",
            "type": "shell",
            "command": "cmake -B build -DZYN_PLATFORM=desktop -DZYN_BUILD_EXAMPLES=ON -DCMAKE_BUILD_TYPE=Debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build (Debug)",
            "type": "shell",
            "command": "cmake -B build -DZYN_PLATFORM=desktop -DZYN_BUILD_EXAMPLES=ON -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j --target desktop_smoke",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake --build build -j",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
